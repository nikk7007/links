# .env.example — MODELO. Copie para .env e preencha com os dados reais.
# O .env NÃO vai pro Git (está no .gitignore).
#
# >>> Onde colocar no servidor (deploy por Git da Hostinger) <<<
# Coloque o .env real na pasta ACIMA do public_html (ex.: /home/SEU_USUARIO/.env).
# Assim ele fica FORA do diretório de deploy e NÃO é apagado a cada deploy.
# (Para rodar local/Docker, um api/config.php também funciona — ver config.sample.php.)

# Banco de dados MySQL (hPanel > Bancos de dados > MySQL)
DB_HOST=localhost
DB_NAME=uXXXXXXXX_links
DB_USER=uXXXXXXXX_admin
DB_PASS=senha_do_banco_aqui
DB_CHARSET=utf8mb4

# Senha do painel admin: guarde só o HASH (gere com o make-hash).
ADMIN_PASS_HASH=$2y$10$substitua.pelo.hash.gerado

# Nome do cookie de sessão do painel (pode deixar assim).
SESSION_NAME=links_admin
